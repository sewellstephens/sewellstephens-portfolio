---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import { Content as AboutContent } from '../content/about.md';
---

<Layout title="Home - Sewell Stephens">
  <main>
    <section class="profile">
      <img src="/profile-picture.jpg" alt="Sewell Stephens" class="profile__image" width="100" height="100" />
      <h2>Hi, I'm Sewell</h2>
      <p>
        I'm the founder of Krastie AI. AI visibility & content platform.
      </p>
    </section>

    <SocialLinks />

    <NewsletterSignup />

    <section class="about">
      <h3>About Me</h3>
      <div class="about__body">
        <AboutContent />
      </div>
    </section>

    <ExperienceSection />

    <footer class="site-footer">
      <p>Copyright &copy; {new Date().getFullYear()} Sewell Stephens</p>
    </footer>
  </main>
</Layout>
